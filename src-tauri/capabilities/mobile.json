{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Permissions required by the iOS and iPadOS application",
  "windows": ["main"],
  "platforms": ["iOS"],
  "permissions": [
    "core:default",
    "deep-link:default",
    "dialog:default",
    "fs:default",
    "fs:allow-appcache-read-recursive",
    "fs:allow-appcache-write-recursive",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    {
      "identifier": "http:default",
      "allow": ["http://**", "https://**"]
    },
    "opener:default",
    "os:default",
    "store:default"
  ]
}
